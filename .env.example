PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/mern_shop
JWT_SECRET=change_me_to_a_long_random_string
CLIENT_URL=http://localhost:3000

# Optional
# Public address of this API (used for SSLCommerz callbacks and uploaded image links). Set it when deployed.
# PUBLIC_API_URL=https://api.example.com
# Key used to encrypt stored gateway passwords (defaults to JWT_SECRET)
# APP_SECRET=another_long_random_string
